# Mẫu cấu hình — copy thành .env rồi điền giá trị thật.
# File .env đã nằm trong .gitignore, KHÔNG commit lên git.

# ── Bắt buộc: thiếu là app không khởi động ───────────────────────────────────
# Sinh cả hai bằng: python -c "import secrets; print(secrets.token_hex(32))"

# Khoá ký JWT (backend)
SECRET_KEY=

# Khoá ký cookie phiên NiceGUI (frontend). Đổi giá trị → đăng xuất toàn bộ user.
STORAGE_SECRET=

# ── Mạng ─────────────────────────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Địa chỉ backend lắng nghe (run.py truyền thẳng cho uvicorn):
#   127.0.0.1 = chỉ nghe trong máy — MẶC ĐỊNH NÊN DÙNG. Trình duyệt người dùng
#               chỉ nói chuyện với frontend cổng 8080; Extension CITAD đi qua
#               proxy cổng 8080 (frontend/api_proxy.py) nên cũng không cần.
#   0.0.0.0   = nghe mọi giao diện mạng — chỉ đặt khi có MÁY KHÁC gọi thẳng
#               cổng 8000; khi đó PHẢI điền luôn ALLOWED_ORIGINS bên dưới.
BACKEND_HOST=127.0.0.1

# Origins được phép gọi API, phân cách bằng dấu phẩy.
# CHẠY TRÊN LAN PHẢI ĐẶT — mặc định chỉ có localhost, máy khác sẽ bị CORS chặn.
# Ví dụ: http://localhost:8080,http://192.168.1.100:8080
ALLOWED_ORIGINS=

# Máy được phép khai IP hộ người khác qua header X-Client-IP, phân cách bằng
# dấu phẩy. Mặc định đã gồm 127.0.0.1 / ::1 (tiến trình frontend cùng máy) —
# chỉ điền thêm khi đặt nginx/IIS đứng TRƯỚC cổng backend. Máy không nằm trong
# danh sách này gửi X-Client-IP thì backend bỏ qua và ghi IP thật của kết nối.
TRUSTED_PROXY_IPS=

# ── Trần kích thước dữ liệu tải lên ──────────────────────────────────────────
# MAX_UPLOAD_MB  : trần cho MỘT file (mặc định 200)
# MAX_REQUEST_MB : trần cho cả thân request, phải >= trần một file vì ACH gửi
#                  nhiều file một lượt (mặc định 600)
# Vượt trần → HTTP 413 kèm thông báo tiếng Việt, không nạp file vào bộ nhớ.
MAX_UPLOAD_MB=
MAX_REQUEST_MB=

# Số việc nặng (sinh Word/Excel/PDF, pandas) được chạy đồng thời. Mặc định 4.
# Đặt cao lên KHÔNG làm nhanh hơn — các thư viện đó là Python thuần, giữ GIL —
# mà chỉ làm request nhẹ bị bỏ đói. Xem backend/core/concurrency.py.
MAX_HEAVY_TASKS=

# ── Word dựng bản xem trước đơn nghỉ phép ────────────────────────────────────
# Mở rồi đóng Word tốn ~3,5 giây, còn chuyển một đơn chỉ tốn ~0,25 giây. Hệ thống
# giữ MỘT bản Word chạy nền để không phải trả cái giá 3,5 giây đó mỗi lần.
#
# WORD_SERVER=0 → quay về cách cũ (mở/đóng Word từng lần, chậm ~4 giây/lần).
# Chỉ tắt khi máy chủ có vấn đề với Word chạy nền.
WORD_SERVER=
# Word rảnh bao nhiêu giây thì tắt để trả lại RAM. Mặc định 900 (15 phút).
# Đặt lớn = nhanh hơn cho người dùng thưa; đặt nhỏ = tiết kiệm RAM máy chủ.
WORD_IDLE_SECONDS=
# Thay bản Word mới sau bao nhiêu lần chuyển đổi. Mặc định 100 — Word chạy lâu
# sẽ phình bộ nhớ, thay định kỳ chỉ tốn ~1 giây của người kế tiếp.
WORD_MAX_JOBS=

# ── Mật khẩu file ZIP nguồn ──────────────────────────────────────────────────
# Dùng chung cho Đối chiếu ACH, Chấm 459901, Đối chiếu Song phương. Đây là mật
# khẩu do đơn vị cấp file đặt, không phải mật khẩu của phần mềm này.
# Trước đây nằm cứng trong mã nguồn nên đã đi vào lịch sử git — nếu mật khẩu cũ
# chưa được đổi thì coi như đã lộ với bất kỳ ai từng clone repo.
# Để trống = ba module trên báo lỗi rõ khi giải nén, phần còn lại vẫn chạy.
#
# NÂNG CẤP MÁY ĐANG CHẠY: dòng này KHÔNG tự sang máy đích. deploy.bat cố ý không
# chép đè .env (để khỏi mất SECRET_KEY), và start.bat chỉ tự sinh được những khoá
# do chính phần mềm đặt ra — mật khẩu của bên ngoài thì phải gõ tay vào .env của
# máy đó rồi khởi động lại. Từ 22/08/2026 deploy.bat cảnh báo nếu còn thiếu.
DOI_CHIEU_ZIP_PASSWORD=

# ── Môi trường ───────────────────────────────────────────────────────────────
# development | production. Để development thì /docs và /redoc MỞ CÔNG KHAI —
# đặt production khi chạy thật.
ENV=development

# Bật /docs, /redoc kể cả khi ENV=production (chỉ dùng lúc gỡ lỗi)
ENABLE_API_DOCS=

# ── Backup ───────────────────────────────────────────────────────────────────
# Thư mục backup phụ, nên ở ổ/máy khác. Để trống nếu không dùng.
# Ví dụ: D:\Backup_KSNB  hoặc  \\192.168.1.50\backup
#
# CẢNH BÁO: phần mềm TỰ XOÁ bản backup quá hạn trong thư mục này (giữ bản mới
# nhất của 7 ngày gần nhất, cộng 5 bản mới nhất). Nó chỉ đụng file đúng mẫu tên
# ksnb_YYYYMMDD_HHMM.db hoặc .zip do chính nó sinh ra — file bạn tự đặt tên thì
# không sao.
# Vì thế: MỖI MÁY CHỦ MỘT THƯ MỤC RIÊNG. Hai máy cùng trỏ vào một thư mục thì
# tên file không phân biệt được nguồn, máy này sẽ xoá bản của máy kia mà cả hai
# đều tưởng mình còn đủ lịch sử.
BACKUP_EXTRA_DIR=

# Mật khẩu nén file sao lưu (AES-256, mở được bằng 7-Zip/WinRAR).
# File .db trần chứa NGUYÊN cột pwd_hash của toàn bộ tài khoản — ai đọc được
# thư mục backup là mang mã băm về dò ngoại tuyến. Đặt mật khẩu ở đây thì bản
# sao lưu ra file .zip đã mã hoá.
#
# MẤT MẬT KHẨU NÀY = KHÔNG MỞ ĐƯỢC BẢN SAO LƯU. Cất vào két mật khẩu của đơn
# vị, đừng chỉ để trong .env trên đúng cái máy mà bản sao lưu dùng để cứu.
# Để trống = ghi ra .db không mã hoá (hệ thống ghi cảnh báo mỗi lần backup).
BACKUP_PASSWORD=

# ── Đồng bộ giờ (chỉ cảnh báo lệch, không tự sửa) ────────────────────────────
NTP_ENABLED=true
NTP_SERVER=pool.ntp.org
NTP_TIMEOUT_SEC=3
NTP_DRIFT_THRESHOLD_SEC=5
