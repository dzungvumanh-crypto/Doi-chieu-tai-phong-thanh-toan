# Mẫu cấu hình — copy thành .env rồi điền giá trị thật.
# File .env đã nằm trong .gitignore, KHÔNG commit lên git.

# ── Bắt buộc: thiếu là app không khởi động ───────────────────────────────────
# Sinh cả hai bằng: python -c "import secrets; print(secrets.token_hex(32))"

# Khoá ký JWT (backend)
SECRET_KEY=

# Khoá ký cookie phiên NiceGUI (frontend). Đổi giá trị → đăng xuất toàn bộ user.
STORAGE_SECRET=

# ── Mạng ─────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Origins được phép gọi API, phân cách bằng dấu phẩy.
# CHẠY TRÊN LAN PHẢI ĐẶT — mặc định chỉ có localhost, máy khác sẽ bị CORS chặn.
# Ví dụ: http://localhost:8080,http://192.168.1.100:8080
ALLOWED_ORIGINS=

# ── Môi trường ───────────────────────────────────────────────────────────────
# development | production. Để development thì /docs và /redoc MỞ CÔNG KHAI —
# đặt production khi chạy thật.
ENV=development

# Bật /docs, /redoc kể cả khi ENV=production (chỉ dùng lúc gỡ lỗi)
ENABLE_API_DOCS=

# ── Backup ───────────────────────────────────────────────────────────────────
# Thư mục backup phụ, nên ở ổ/máy khác. Để trống nếu không dùng.
# Ví dụ: D:\Backup_KSNB  hoặc  \\192.168.1.50\backup
BACKUP_EXTRA_DIR=

# ── Đồng bộ giờ (chỉ cảnh báo lệch, không tự sửa) ────────────────────────────
NTP_ENABLED=true
NTP_SERVER=pool.ntp.org
NTP_TIMEOUT_SEC=3
NTP_DRIFT_THRESHOLD_SEC=5
